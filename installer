#!/usr/bin/env bash
# Installe le site de test Genius Recrutement à côté du CRM, sans toucher au CRM lui-même :
# un petit conteneur sert la page, et le Caddy du CRM (déjà sur les ports 80/443)
# reçoit un bloc pour recrutement.alveris-consulting.com.
set -euo pipefail
DOMAINE=recrutement.alveris-consulting.com
SITE_NOM=genius-recrutement-site
DOSSIER="$(cd "$(dirname "$0")" && pwd)"

# Le serveur n'avait plus de serveur DNS : on en fixe deux, de façon durable.
if [ ! -f /etc/systemd/resolved.conf.d/dns-public.conf ]; then
  mkdir -p /etc/systemd/resolved.conf.d
  printf '[Resolve]\nDNS=1.1.1.1 8.8.8.8\nFallbackDNS=9.9.9.9\n' > /etc/systemd/resolved.conf.d/dns-public.conf
  systemctl restart systemd-resolved
  sleep 2
  echo "DNS du serveur fixés (1.1.1.1, 8.8.8.8)."
fi
getent hosts acme-v02.api.letsencrypt.org >/dev/null || { echo "ERREUR : le serveur ne trouve toujours pas les adresses internet."; exit 1; }

C=$(docker ps --format '{{.Names}}' | grep -E 'caddy' | head -n1 || true)
[ -n "$C" ] || { echo "ERREUR : conteneur Caddy du CRM introuvable."; exit 1; }
echo "Caddy du CRM : $C"

CF=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy/Caddyfile"}}{{.Source}}{{end}}{{end}}' "$C")
if [ -z "$CF" ]; then
  D=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy"}}{{.Source}}{{end}}{{end}}' "$C")
  [ -n "$D" ] && CF="$D/Caddyfile"
fi
[ -n "$CF" ] && [ -f "$CF" ] || { echo "ERREUR : Caddyfile du CRM introuvable."; exit 1; }
echo "Caddyfile : $CF"

NET=$(docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' "$C" | head -n1)
echo "Réseau : $NET"

docker rm -f "$SITE_NOM" >/dev/null 2>&1 || true
docker run -d --name "$SITE_NOM" --restart unless-stopped --network "$NET" \
  -v "$DOSSIER/site/recrutement:/usr/share/caddy:ro" caddy:2.8.4-alpine >/dev/null
echo "Conteneur du site lancé."

if grep -q "$DOMAINE" "$CF"; then
  echo "Bloc déjà présent dans le Caddyfile."
else
  SAUVE="$CF.avant-genius-$(date +%Y%m%d-%H%M%S)"
  cp -p "$CF" "$SAUVE"
  echo "Sauvegarde : $SAUVE"
  cat >> "$CF" <<BLOC

$DOMAINE {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	reverse_proxy $SITE_NOM:80
}
BLOC
  if ! docker exec "$C" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    cat "$SAUVE" > "$CF"
    echo "ERREUR : configuration refusée, le Caddyfile du CRM a été remis comme avant."
    exit 1
  fi
fi

docker exec "$C" caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
echo
echo "TERMINE : https://$DOMAINE (le certificat HTTPS peut prendre une minute)."
