# Proxy commun du VPS : chaque sous-domaine d'Alveris Consulting est déclaré ici.
# Caddy obtient et renouvelle seul les certificats HTTPS (Let's Encrypt).
{
	email consultingalveris@gmail.com
}

recrutement.alveris-consulting.com {
	encode zstd gzip
	root * /srv/recrutement
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
